{
  "name": "n8n-nodes-pdf-render",
  "version": "1.0.0",
  "description": "n8n community node that renders PDF pages to PNG images with the pdf.js and @napi-rs/canvas that n8n itself ships",
  "license": "MIT",
  "author": {
    "name": "Lubos Voska"
  },
  "homepage": "https://github.com/LubosVoska/n8n-nodes-pdf-render#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LubosVoska/n8n-nodes-pdf-render.git"
  },
  "bugs": {
    "url": "https://github.com/LubosVoska/n8n-nodes-pdf-render/issues"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "pdf",
    "png",
    "pdf-to-png",
    "pdf-to-image",
    "render",
    "pdfjs"
  ],
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "nodes",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "nodes/PdfRender/PdfRender.node.js"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "peerDependenciesMeta": {
    "n8n-workflow": {
      "optional": true
    }
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.11",
    "canvas-old": "npm:@napi-rs/canvas@0.1.100",
    "pdfjs-dist": "6.3.289"
  }
}
